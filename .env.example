# Copy to .env (local) or .env.production (server). Never commit the real file.

APP_NAME=Orleeno
# development | staging | production
APP_ENV=development
BUSINESS_TIMEZONE=Asia/Kolkata

# ── Database ─────────────────────────────────────────────
# Either DATABASE_URL, or the DB_* parts
# DATABASE_URL=postgresql://orleeno:change-me@localhost:5432/mealoo
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mealoo
DB_USER=postgres
DB_PASSWORD=change-me

# ── Auth ─────────────────────────────────────────────────
# 32+ random characters in production, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=720
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── OTP (no SMS gateway yet) ─────────────────────────────
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_HOUR=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
# Returns the OTP in the API response for testing. Ignored (always off) in production.
OTP_ECHO_IN_RESPONSE=true

# ── Money ────────────────────────────────────────────────
# Legacy fallback for orders priced before the pricing engine existed;
# the live partner payout is configured in Admin > Pricing.
DELIVERY_BOY_FEE_PER_DELIVERY=30.00
# Self top-up adds wallet money WITHOUT a real payment. Default: on outside production, off in production.
# WALLET_SELF_TOPUP_ENABLED=false
WALLET_TOPUP_MAX_AMOUNT=10000.00
WALLET_TOPUP_DAILY_LIMIT=25000.00
DELIVERY_CODE_MAX_ATTEMPTS=5

# ── Ordering windows ─────────────────────────────────────
EXTRA_ORDER_MAX_DAYS_AHEAD=9
SUBSCRIPTION_MAX_START_DAYS_AHEAD=30
CUSTOM_PLAN_MIN_DAYS=1
CUSTOM_PLAN_MAX_DAYS=90

# ── Files ────────────────────────────────────────────────
# Must be a persistent volume in production
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
MAX_REQUEST_BYTES=8388608

# ── HTTP ─────────────────────────────────────────────────
# Browser origins allowed to call the API (admin web). https:// only in production.
CORS_ORIGINS=http://localhost:5173
# Swagger UI. Default: on outside production, off in production.
# ENABLE_API_DOCS=false
# true only behind a proxy that overwrites X-Forwarded-For (see deploy/nginx.conf)
TRUST_PROXY_HEADERS=false

# ── Jobs ─────────────────────────────────────────────────
# Exactly one process runs the scheduler; API replicas set false.
RUN_SCHEDULER=true
STALE_SWEEP_LOOKBACK_DAYS=7
LOG_LEVEL=INFO

# ── Admin seeder (seeds/admin_users_seeder.py) ───────────
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=
# ADMIN_SEED_ROLE=super_admin
